{
  "name": "ultrastar-web-manager",
  "version": "0.8.0",
  "description": "Gestionnaire web de bibliothèque de chansons UltraStar",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "author": "Didier MATHIEU",
  "license": "MIT",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5"
  }
}
