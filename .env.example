# Copier ce fichier en .env et adapter les chemins
PORT=3000
# 127.0.0.1 = accessible uniquement depuis ce PC ; 0.0.0.0 = depuis le réseau local
HOST=127.0.0.1
# Dossier racine des chansons UltraStar
SONG_DIR=C:\UltraStar\songs
# Dossier des playlists (.upl)
PLAYLIST_DIR=C:\UltraStar\playlists
# Images des catégories (langues, décennies, éditions) : dossier « covers » d'UltraStar Deluxe
# (lecture seule). Optionnel : sans lui, les tuiles affichent des initiales.
CATEGORY_COVERS_DIR=C:\Program Files (x86)\UltraStar Deluxe\covers

# --- Sécurité ------------------------------------------------------------------------------
# Clés d'accès (12 caractères minimum, toutes différentes), pour les autres appareils du réseau :
#   READ_KEY  = lecture (consulter, écouter)
#   WRITE_KEY = écriture (corriger tags, pochettes, playlists)
#   ADMIN_KEY = admin (en plus : supprimer)
# READ_KEY vide = lecture ouverte à tout le monde (seules l'écriture et l'admin demandent une clé).
# Dès que HOST n'est pas 127.0.0.1 : au moins WRITE_KEY ou ADMIN_KEY. Sur ce PC : admin sans clé.
# Changer une clé déconnecte tous les appareils.
READ_KEY=
WRITE_KEY=
ADMIN_KEY=
# Noms d'hôte supplémentaires acceptés (séparés par des virgules), ex. karaoke.lan
ALLOWED_HOSTS=
# false = exiger une clé même sur ce PC
TRUST_LOCALHOST=true
# Durée d'une connexion (jours)
SESSION_DAYS=30

# --- Modifications ---------------------------------------------------------------------------
# Dossier des sauvegardes datées, faites avant chaque modification d'un fichier chanson
# (défaut : dossier « backups » du projet, ignoré par git).
BACKUP_DIR=

# ffmpeg, pour convertir les vidéos en MP4 H.264 (fenêtre info). Chemin complet de
# ffmpeg.exe, ffprobe.exe doit être dans le même dossier. Vide = « ffmpeg » du PATH.
# Exemple : FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=

# --- Préférences ---------------------------------------------------------------------------
# Fichier des préférences réglées dans l'interface (normes de nommage…).
# Défaut : settings.json à la racine du projet (ignoré par git).
SETTINGS_FILE=
